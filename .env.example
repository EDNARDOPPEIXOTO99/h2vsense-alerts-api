# Copie para .env e ajuste. O arquivo .env NUNCA vai para o Git (está no .gitignore).

# --- Aplicação ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DB_POOL_MAX=10

# Rodando a API fora do Docker (npm run dev), aponte para o Postgres exposto pelo Compose:
DATABASE_URL=postgres://h2vsense:troque-esta-senha@localhost:5432/h2vsense

# --- Política de classificação (% do LIE do H2 = 40.000 ppm) ---
ATTENTION_PCT_LEL=10
ALARM_PCT_LEL=25

# --- Docker Compose ---
POSTGRES_DB=h2vsense
POSTGRES_USER=h2vsense
POSTGRES_PASSWORD=troque-esta-senha
API_PORT=3000
DB_PORT=5432
